# Pollinexus API Environment Configuration
# Copy this file to .env and update the values for your environment

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
POLLINEXUS_APP_NAME="Pollinexus API"
POLLINEXUS_VERSION="0.1.0"
POLLINEXUS_ENVIRONMENT="development"  # development, staging, production
POLLINEXUS_DEBUG="true"

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
POLLINEXUS_DATABASE_URL="duckdb:///pollinexus.db"
POLLINEXUS_DATABASE_POOL_SIZE="5"
POLLINEXUS_DATABASE_MAX_OVERFLOW="10"
POLLINEXUS_DATABASE_POOL_TIMEOUT="30"
POLLINEXUS_DATABASE_POOL_RECYCLE="3600"

# =============================================================================
# SECURITY SETTINGS
# =============================================================================
POLLINEXUS_API_SECRET_KEY="your-secret-key-here-change-in-production"
POLLINEXUS_JWT_SECRET_KEY="your-jwt-secret-key-here-change-in-production"
POLLINEXUS_JWT_ALGORITHM="HS256"
POLLINEXUS_JWT_EXPIRATION_HOURS="24"

# =============================================================================
# RATE LIMITING
# =============================================================================
POLLINEXUS_RATE_LIMIT_REQUESTS="100"
POLLINEXUS_RATE_LIMIT_PERIOD="60"
POLLINEXUS_RATE_LIMIT_BURST="200"

# =============================================================================
# CORS CONFIGURATION
# =============================================================================
POLLINEXUS_CORS_ORIGINS='["http://localhost:3000", "http://localhost:8000", "http://127.0.0.1:3000", "http://127.0.0.1:8000"]'
POLLINEXUS_CORS_ALLOW_CREDENTIALS="true"
POLLINEXUS_CORS_ALLOW_METHODS='["GET", "POST", "PUT", "DELETE", "OPTIONS"]'
POLLINEXUS_CORS_ALLOW_HEADERS='["*"]'

# =============================================================================
# FILE UPLOAD SETTINGS
# =============================================================================
POLLINEXUS_UPLOAD_DIR="uploads"
POLLINEXUS_MAX_FILE_SIZE="104857600"  # 100MB in bytes
POLLINEXUS_ALLOWED_FILE_EXTENSIONS='[".csv", ".xlsx", ".xls", ".json"]'

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
POLLINEXUS_LOG_LEVEL="INFO"
POLLINEXUS_LOG_FORMAT="json"  # json or text
POLLINEXUS_LOG_FILE="application.log"
POLLINEXUS_LOG_ROTATION="midnight"
POLLINEXUS_LOG_RETENTION="30"

# =============================================================================
# MONITORING AND METRICS
# =============================================================================
POLLINEXUS_ENABLE_METRICS="true"
POLLINEXUS_METRICS_ENDPOINT="true"
POLLINEXUS_HEALTH_CHECK_TIMEOUT="30"

# =============================================================================
# CACHE SETTINGS
# =============================================================================
POLLINEXUS_CACHE_BACKEND="memory"  # memory, redis
POLLINEXUS_CACHE_DEFAULT_TIMEOUT="300"
POLLINEXUS_CACHE_MAX_ENTRIES="1000"

# =============================================================================
# CELERY TASK QUEUE
# =============================================================================
# For local development, use Redis if available, otherwise tasks run synchronously
POLLINEXUS_CELERY_BROKER_URL="redis://localhost:6379/0"
POLLINEXUS_CELERY_RESULT_BACKEND="redis://localhost:6379/0"
POLLINEXUS_CELERY_TASK_TIME_LIMIT="1800"  # 30 minutes
POLLINEXUS_CELERY_TASK_SOFT_TIME_LIMIT="1500"  # 25 minutes
POLLINEXUS_CELERY_WORKER_MAX_TASKS_PER_CHILD="1000"
POLLINEXUS_CELERY_WORKER_PREFETCH_MULTIPLIER="4"

# =============================================================================
# EMAIL NOTIFICATIONS (Optional)
# =============================================================================
POLLINEXUS_SMTP_SERVER=""
POLLINEXUS_SMTP_PORT="587"
POLLINEXUS_SMTP_USERNAME=""
POLLINEXUS_SMTP_PASSWORD=""
POLLINEXUS_SMTP_USE_TLS="true"

# =============================================================================
# WHATSAPP NOTIFICATIONS (Optional)
# =============================================================================
POLLINEXUS_WHATSAPP_API_URL=""
POLLINEXUS_WHATSAPP_API_TOKEN=""

# =============================================================================
# SECURITY POLICIES
# =============================================================================
POLLINEXUS_PASSWORD_MIN_LENGTH="8"
POLLINEXUS_PASSWORD_REQUIRE_SPECIAL="true"
POLLINEXUS_PASSWORD_REQUIRE_NUMBERS="true"
POLLINEXUS_PASSWORD_REQUIRE_UPPERCASE="true"
POLLINEXUS_SESSION_TIMEOUT="86400"  # 24 hours in seconds
POLLINEXUS_MAX_LOGIN_ATTEMPTS="5"
POLLINEXUS_LOCKOUT_DURATION="900"  # 15 minutes in seconds

# =============================================================================
# LOCAL DEVELOPMENT SETTINGS
# =============================================================================
# Set to "true" to disable security middleware for local development
# This will bypass rate limiting, IP blocking, and input validation
POLLINEXUS_DISABLE_SECURITY_FOR_LOCAL="true"

# =============================================================================
# PRODUCTION SETTINGS
# =============================================================================
POLLINEXUS_RELOAD="false"
POLLINEXUS_WORKERS="1"

# =============================================================================
# SSL/TLS SETTINGS (Production Only)
# =============================================================================
POLLINEXUS_SSL_KEYFILE=""
POLLINEXUS_SSL_CERTFILE=""
POLLINEXUS_USE_SSL="false"

# =============================================================================
# TRUSTED HOSTS (Production Only)
# =============================================================================
POLLINEXUS_TRUSTED_HOSTS='["localhost", "127.0.0.1", "host.docker.internal"]'

# =============================================================================
# PERFORMANCE SETTINGS
# =============================================================================
POLLINEXUS_REQUEST_TIMEOUT="30"
POLLINEXUS_KEEP_ALIVE_TIMEOUT="5"
POLLINEXUS_MAX_CONNECTIONS="1000"
POLLINEXUS_MAX_CONNECTION_SIZE="16384"

# =============================================================================
# DATA PROCESSING LIMITS
# =============================================================================
POLLINEXUS_MAX_DATASET_ROWS="1000000"
POLLINEXUS_MAX_PROCESSING_TIME="3600"  # 1 hour
POLLINEXUS_MAX_MEMORY_USAGE_MB="4096"  # 4GB

# =============================================================================
# FEATURE FLAGS
# =============================================================================
POLLINEXUS_ENABLE_USER_REGISTRATION="true"
POLLINEXUS_ENABLE_ANONYMOUS_ACCESS="false"
POLLINEXUS_ENABLE_DATA_EXPORT="true"
POLLINEXUS_ENABLE_VISUALIZATION_DOWNLOAD="true"

# =============================================================================
# PRODUCTION OVERRIDES (uncomment for production)
# =============================================================================
# POLLINEXUS_ENVIRONMENT="production"
# POLLINEXUS_DEBUG="false"
# POLLINEXUS_LOG_LEVEL="INFO"
# POLLINEXUS_USE_SSL="true"
# POLLINEXUS_CORS_ORIGINS='["https://yourdomain.com", "https://www.yourdomain.com"]'
# POLLINEXUS_TRUSTED_HOSTS='["yourdomain.com", "www.yourdomain.com"]'
# POLLINEXUS_DATABASE_URL="postgresql://user:password@localhost/pollinexus"
# POLLINEXUS_CELERY_BROKER_URL="redis://localhost:6379/0"
# POLLINEXUS_CELERY_RESULT_BACKEND="redis://localhost:6379/0" 

# Security settings
# POLLINEXUS_DISABLE_SECURITY_FOR_LOCAL=true 